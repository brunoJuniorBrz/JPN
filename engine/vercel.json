{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "git": {
    "deploymentEnabled": {
      "feat/roof-area-load-path": false,
      "audit/mission21-independent": false,
      "feat/resistance-elastic-reference": false
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,examples/**,validation-results/**,**/__pycache__/**,**/*.pyc,benchmark_*.py,audit_*.py,validate.py,Dockerfile,.dockerignore}"
    }
  }
}
