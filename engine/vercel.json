{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "git": {
    "deploymentEnabled": {
      "feat/roof-area-load-path": false,
      "audit/mission21-independent": false,
      "feat/resistance-elastic-reference": false,
      "integration/m21-studio-release-candidate": false,
      "feat/engineering-m22-m24": false,
      "feat/m23-resistant-design": false,
      "feat/m24-connections-stability": false,
      "feat/m25-preproduction-dossier": false,
      "feat/m26-integrated-normative-engine": false
    }
