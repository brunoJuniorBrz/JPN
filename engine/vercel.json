{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "python",
  "installCommand": "uv sync --extra sections",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": false,
      "codex/int-2-*": false,
      "integration/jpn-general-candidate": false
    }
  },
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,examples/**,validation-results/**,**/__pycache__/**,**/*.pyc,benchmark_*.py,audit_*.py,validate.py,Dockerfile,.dockerignore}"
    }
  }
}
