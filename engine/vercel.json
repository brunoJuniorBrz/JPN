      "maxDuration": 30,
      "excludeFiles": "{tests/**,examples/**,validation-results/**,**/__pycache__/**,**/*.pyc,benchmark_*.py,audit_*.py,validate.py,Dockerfile,.dockerignore}"
    }
  }
}
